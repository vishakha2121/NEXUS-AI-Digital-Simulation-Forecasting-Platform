# !backend/app/ml_models/trained_models/.gitkeep
# !ml_models/trained_models/example_model.pkl
# ============================================
# NEXUS AI Platform - .gitignore
# Comprehensive ignore file for Python, React, and Docker projects
# ============================================

# ============================================
# PYTHON
# ============================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/
pip-log.txt

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
*.mo
*.pot

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebooks
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
Pipfile.lock

# poetry
poetry.lock

# pdm
.pdm.toml

# PEP 582
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# Profiling data
.prof

# ============================================
# NODE / REACT / FRONTEND
# ============================================

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.cache/

# Environment variables
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vite
.vite/
vite.config.js.timestamp-*

# Testing
coverage/
.nyc_output/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.workspace
.project
.classpath
.settings/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# ============================================
# DATABASE
# ============================================

# PostgreSQL
*.sqlite
*.sqlite3
*.db
*.db-journal

# MySQL
*.myd
*.myi
*.frm

# Redis
*.rdb
*.aof

# Database dumps
*.sql.gz
*.sql.bak
*.dump

# ============================================
# DOCKER
# ============================================

# Docker volumes
docker-volume/
docker-volumes/
*.pem
*.crt
*.key

# Docker secrets
docker/secrets/
*.secrets

# ============================================
# ML / DATA SCIENCE
# ============================================

# Model files
*.pkl
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.pb
*.tflite
*.onnx
*.onnx.data

# Data files
*.csv
*.xlsx
*.xls
*.tsv
*.parquet
*.feather
*.arrow

# Jupyter notebooks
*.ipynb
*.ipynb_checkpoints/

# TensorFlow
*.ckpt
*.meta
*.index
*.data-*

# MLflow
mlruns/
mlflow.db

# DVC
.dvc/
*.dvc

# ============================================
# SECURITY & CREDENTIALS
# ============================================

# API Keys
.env
.env.*
*.env
*.key
*.pem
*.crt
*.cert
*.p12
*.pfx
*.keystore
*.jks

# SSH keys
*.pem
*.ppk
id_rsa
id_dsa
id_ecdsa
id_ed25519

# Password files
.passwd
.htpasswd
.htaccess
.htpasswd

# ============================================
# LOGGING
# ============================================

# Log files
*.log
logs/
log/
*.out
*.err

# ============================================
# TEMPORARY FILES
# ============================================

*.tmp
*.temp
*.swp
*.swo
*~
*.bak
*.cache
*.cached
*.temp

# ============================================
# PROJECT SPECIFIC
# ============================================

# NEXUS specific
backend/.env
backend/.env.local
backend/alembic/versions/*.pyc

# Frontend build
frontend/dist/
frontend/build/
frontend/.env.local

# ML models (trained models are large)
ml_models/trained_models/*.pkl
ml_models/trained_models/*.joblib
ml_models/trained_models/*.h5
ml_models/trained_models/*.pt

# Database dumps
database/dumps/
database/*.sql.gz

# IDE specific
.vscode/
.idea/
*.iml
*.iws
*.ipr

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml

# Sphinx
docs/_build/

# ============================================
# CELERY
# ============================================

celerybeat-schedule
celerybeat.pid
celeryd.pid

# ============================================
# PYTEST
# ============================================

.pytest_cache/
.tox/
.coverage
coverage.xml
htmlcov/

# ============================================
# DOCKER
# ============================================

*.pid
*.pid.lock
docker-compose.override.yml
docker-compose.*.yml

# ============================================
# OTHER
# ============================================

# Archives
*.zip
*.tar.gz
*.rar
*.7z

# Media
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.mkv
*.mp3
*.wav
*.flac
*.aac
*.ogg
*.wma

# Images (large)
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.psd
*.ai
*.eps

