# ============================================
# NOTES
# ============================================
# This .gitignore is comprehensive for:
# ✅ Python FastAPI backend
# ✅ React frontend
# ✅ PostgreSQL database
# ✅ ML models (trained models excluded)
# ✅ Docker configuration
# ✅ Security credentials
# ✅ IDE files
# ✅ OS files
# ✅ Temporary files

# ============================================
# EXCEPTIONS (Files to TRACK)
# ============================================
# !.gitkeep
# !backend/app/ml_models/trained_models/.gitkeep
# !ml_models/trained_models/example_model.pkl
# ============================================
# NEXUS AI Platform - .gitignore
# Comprehensive ignore file for Python, React, and Docker projects
# ============================================

# ============================================
# PYTHON
# ============================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/
pip-log.txt

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
*.mo
*.pot

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

